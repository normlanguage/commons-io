package sample.commons.io

import commons.io.filenameUtilsGetExtension
import commons.io.fileUtilsWriteStringToFile
import commons.io.fileUtilsReadFileToString
import commons.io.fileUtilsDeleteQuietly
import java.base.io.fileNew

Void main() {
  printLine(filenameUtilsGetExtension("archive.nar") ?? "")
  var file = fileNew("build/commons-io-binding-example.txt")!!
  fileUtilsWriteStringToFile(
    arg0: file,
    arg1: "NAR",
    arg2: "UTF-8"
  )
  printLine(
    fileUtilsReadFileToString(arg0: file, arg1: "UTF-8")!!
  )
  fileUtilsDeleteQuietly(arg0: file)
}





